# OpenAI-compatible base URL, for example: https://api.openai.com/v1
providerBaseUrl: "https://api.openai.com/v1"

# Fill in a real API key to enable live planner requests.
apiKey: ""

# Model name exposed by the configured provider.
model: ""

# OpenAI-compatible base URL for vision requests.
visionProviderBaseUrl: "https://api.openai.com/v1"

# Fill in a real API key to enable live vision requests.
visionApiKey: ""

# Vision-capable model name exposed by the configured provider.
# For OpenAI, a practical default is: gpt-4.1-mini
visionModel: ""

# Planner request timeout in milliseconds.
requestTimeoutMillis: 15000

# Vision request timeout in milliseconds.
visionRequestTimeoutMillis: 10000

# Number of recent dialogue turns retained in planner context.
maxRecentConversationTurns: 8

# Image detail hint passed to compatible multimodal providers: low | high | auto
visionImageDetail: "low"
